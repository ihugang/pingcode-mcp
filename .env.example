# OAuth Client ID. Set together with PINGCODE_CLIENT_SECRET; do not commit credentials or write them to logs.
PINGCODE_CLIENT_ID=replace-me
# OAuth Client Secret. Keep local only; never commit it or include it in logs.
PINGCODE_CLIENT_SECRET=replace-me

# PingCode REST base URL; default is https://open.pingcode.com. Use an absolute HTTP(S) URL without query or fragment.
PINGCODE_BASE_URL=https://open.pingcode.com

# Defaults to true and is the global write gate; keep true except during explicitly authorized isolated tests.
PINGCODE_READ_ONLY=true

# Comma-separated project ID allowlist for targeted reads and writes; a blank list authorizes no project operations.
PINGCODE_ALLOWED_PROJECT_IDS=

# Positive HTTP request timeout, for example 30s; default is 30s.
PINGCODE_HTTP_TIMEOUT=30s

# stderr log level: debug, info, warn, or error; default is info. Never put credentials in logs.
PINGCODE_LOG_LEVEL=info
